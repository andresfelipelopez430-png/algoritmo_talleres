Algoritmo valor_mayor_menor
	Escribir 'Vamos a hallar el valor mayor y menor'
	Escribir 'ingresar valor uno'
	Leer num1
	Escribir ' ingresar valor dos'
	Leer num2
	Si num1>num2 Entonces
		Escribir 'el resultado mayor es:', num1
		Escribir 'el resultado menor es:', num2
	SiNo
		Si num1<num2 Entonces
			Escribir 'el resultado mayor es:', num2
			Escribir 'el resultado menor es:', num1
		FinSi
	FinSi
FinAlgoritmo
