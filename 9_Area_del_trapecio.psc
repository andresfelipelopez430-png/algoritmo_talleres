Algoritmo Area_del_trapecio
	Definir baseMenor, baseMayor, altura Como Real
	Definir areaTrapecio Como Real
	Escribir 'Digite la base menor:'
	Leer baseMenor
	Escribir 'Digite la base mayor:'
	Leer baseMayor
	Escribir 'Digite la altura'
	Leer altura
	areaTrapecio <- (baseMenor+baseMayor)/2*altura
	Escribir 'El area del trapecio es:', areaTrapecio
FinAlgoritmo
