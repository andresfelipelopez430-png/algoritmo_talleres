Algoritmo area_triangulo
	Definir base, altura, area Como Real
	Escribir 'Vamos a calcular el área de un tríangulo'
	Escribir 'Por favor dígita la Base en numeros'
	Leer base
	Escribir 'Por favor digita la Altura en numeros'
	Leer altura
	area <- (base*altura)/2
	Escribir 'El area de un triangulo es ', area
FinAlgoritmo
