Algoritmo Conversion
	Definir metros, kilometros, hectometros, decametros, decimetros, centimetros, milimetros Como Real
	Escribir 'Digite los metros en numeros'
	Leer metros
	kilometros <- metros/1000
	hectometros <- metros/100
	decametros <- metros/10
	decimetros <- metros*10
	centimetros <- metros*100
	milimetros <- metros*1000
	Escribir 'la conversion de metros a kilometros es: ', kilometros
	Escribir 'la conversion de metros a hectometros es: ', hectometros
	Escribir 'la conversion de metros a decametros es: ', decametros
	Escribir 'la conversion de metros a decimetros es: ', decimetros
	Escribir 'la conversion de metros a centimetros es: ', centimetros
	Escribir 'la conversion de metros a milimetros es: ', milimetros
FinAlgoritmo
