Algoritmo area_rombo
	Definir diagonalMenor, diagonalMayor, areaRombo Como Real
	Escribir 'Digite la diagonal menor'
	Leer diagonalMenor
	Escribir 'Digite la diagonal mayor'
	Leer diagonalMayor
	areaRombo <- (diagonalMayor*diagonalMenor)/2
	Escribir 'El  area del rombo es: ', areaRombo
FinAlgoritmo
